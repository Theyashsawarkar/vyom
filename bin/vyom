#!/usr/bin/env python3
"""vyom: the runtime for Vayu's panels (the wofi replacement).

  vyom <tool> [args...]     open a tool (e.g. vyom dvara, vyom tarang); again closes it
  vyom dmenu [-p PROMPT] [--markup] < lines
                            pick one line (printed; exit 1 on Esc), like dmenu/wofi --dmenu
  vyom list                 installed tools, and why any is skipped
  vyom daemon               start Vyom in the background (sway runs this at login)
  vyom reload               re-read ~/.config/vyom/config.toml and the styles
  vyom quit                 stop it
  vyom quick                quick settings (the kendra tool)
  vyom --version | --help

Vyom keeps one resident process. When it's running, this script only sends
it a D-Bus message (no GTK start-up), so a panel opens at once. Tools are
separate repositories cloned into ~/.local/share/vyom/plugins/<name>.
"""
import glob
import json
import os
import subprocess
import sys
import tempfile
import time

APP_ID, OBJ = "dev.vayu.Vyom", "/dev/vayu/Vyom"
ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
RUNTIME = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or tempfile.gettempdir(), "vyom")
STATE = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "vyom")


def running():
    r = subprocess.run(["busctl", "--user", "call", "org.freedesktop.DBus", "/org/freedesktop/DBus",
                        "org.freedesktop.DBus", "NameHasOwner", "s", APP_ID],
                       capture_output=True, text=True)
    return r.stdout.strip() == "b true"


def gvariant_str(s):
    return "'" + s.replace("\\", "\\\\").replace("'", "\\'") + "'"


def action(name, param=None):
    params = "[]" if param is None else f"[<{gvariant_str(param)}>]"
    return subprocess.run(["gdbus", "call", "--session", "--dest", APP_ID, "--object-path", OBJ,
                           "--method", "org.gtk.Actions.Activate", name, params, "{}"],
                          stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode


def ensure_daemon():
    """Starts `vyom daemon` in the background if it isn't running and waits
    (up to 8 s) for it to be ready."""
    if running():
        return True
    os.makedirs(STATE, exist_ok=True)
    with open(os.path.join(STATE, "daemon.log"), "a") as log:
        subprocess.Popen([sys.executable, os.path.realpath(__file__), "daemon"], stdin=subprocess.DEVNULL,
                         stdout=log, stderr=log, start_new_session=True)
    for _ in range(80):
        time.sleep(0.1)
        if running():
            return True
    print(f"vyom: the daemon didn't start (see {STATE}/daemon.log)", file=sys.stderr)
    return False


def dmenu(argv):
    prompt, markup = "", False
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("-p", "--prompt") and i + 1 < len(argv):
            prompt, i = argv[i + 1], i + 1
        elif a == "--markup":
            markup = True
        i += 1
    options = [l.rstrip("\n") for l in sys.stdin if l.strip()]
    os.makedirs(RUNTIME, exist_ok=True)
    fd, req = tempfile.mkstemp(prefix="dmenu-", suffix=".json", dir=RUNTIME)
    reply = req[:-5] + ".reply"
    os.mkfifo(reply)
    try:
        with os.fdopen(fd, "w") as f:
            json.dump({"prompt": prompt, "options": options, "markup": markup, "reply": reply}, f)
        if not ensure_daemon() or action("dmenu", req) != 0:
            return 2
        # Killed while waiting (the caller got its answer elsewhere, e.g.
        # from a notification): close the panel too.
        import signal

        def withdrawn(*_):
            action("close")
            sys.exit(1)
        signal.signal(signal.SIGTERM, withdrawn)
        signal.signal(signal.SIGINT, withdrawn)
        with open(reply) as f:   # blocks until a pick or Esc
            out = f.read()
    finally:
        for p in (req, reply):
            if os.path.exists(p):
                os.unlink(p)
    if not out:
        return 1
    sys.stdout.write(out)
    return 0


def list_tools():
    sys.path.insert(0, ROOT)
    import shutil
    import tomllib
    from vyom.app import plugin_dirs  # noqa: imports gi too, fine for a listing
    for d in plugin_dirs():
        with open(os.path.join(d, "plugin.toml"), "rb") as f:
            m = tomllib.load(f)
        missing = [t for t in m.get("requires", []) if not shutil.which(os.path.expanduser(t).split()[0])]
        state = f"needs {', '.join(missing)}" if missing else "ok"
        print(f"{m.get('name', '?'):10} {m.get('version', ''):8} {m.get('title', ''):18} {state:12} {d}")


def main():
    args = sys.argv[1:]
    cmd = args[0] if args else "--help"
    if cmd in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    if cmd in ("-V", "--version"):
        sys.path.insert(0, ROOT)
        from vyom import VERSION
        print(f"vyom {VERSION}")
        return 0
    if cmd == "dmenu":
        return dmenu(args[1:])
    if cmd == "list":
        list_tools()
        return 0
    if cmd in ("reload", "quit"):
        return action(cmd) if running() else 0
    if cmd != "daemon":
        # Open a tool ("quick" is quick settings, the kendra tool).
        name = "kendra" if cmd == "quick" else cmd
        if not ensure_daemon():
            return 1
        return action("open", json.dumps([name, *args[1:]]))
    if running():
        return 0
    # gtk4-layer-shell must be loaded before GTK itself: re-run with it preloaded.
    lib = next(iter(sorted(glob.glob("/usr/lib*/libgtk4-layer-shell.so*") +
                           glob.glob("/usr/lib/*/libgtk4-layer-shell.so*"))), None)
    if lib is None:
        print("vyom: needs gtk4-layer-shell (pacman -S gtk4-layer-shell)", file=sys.stderr)
        return 1
    if lib not in os.environ.get("LD_PRELOAD", ""):
        os.environ["LD_PRELOAD"] = ":".join(p for p in (lib, os.environ.get("LD_PRELOAD")) if p)
        os.execv(sys.executable, [sys.executable, os.path.realpath(__file__), *args])
    sys.path.insert(0, ROOT)
    from vyom.app import main as app_main
    return app_main([sys.argv[0], "daemon"])


if __name__ == "__main__":
    sys.exit(main())
